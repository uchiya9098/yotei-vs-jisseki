# Supabase（プロジェクト設定 > API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio（https://aistudio.google.com/apikey から取得）
# サーバー側（API Route）でのみ使用するため NEXT_PUBLIC_ を付けない
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# アプリのベースURL（OAuthリダイレクト用。本番はVercelのURLに変更）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
